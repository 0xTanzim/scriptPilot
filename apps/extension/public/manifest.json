{
  "manifest_version": 3,
  "name": "ScriptPilot",
  "version": "0.1.0",
  "description": "Advanced userscript manager with TypeScript support, DevTools integration, and plugin system",
  "author": "ScriptPilot Team",

  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "unlimitedStorage",
    "webNavigation",
    "contextMenus",
    "notifications"
  ],

  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],

  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/index.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "ScriptPilot",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "devtools_page": "src/devtools/devtools.html",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "options_page": "src/popup/popup.html",

  "web_accessible_resources": [
    {
      "resources": ["src/content/gmapi-injection.js", "src/popup/popup-init.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline';"
  }
}
